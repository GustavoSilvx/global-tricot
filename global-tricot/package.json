{
  "name": "global-tricot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bash supabase/tests/run-integration.sh",
    "build:sql": "node -e \"const fs=require('fs');const f=fs.readdirSync('supabase/migrations').filter(n=>n.endsWith('.sql')).sort();fs.writeFileSync('supabase/setup-completo.sql','-- Global Tricot: instala\u00e7\u00e3o completa (gerado de supabase/migrations/*.sql com npm run build:sql)\\n-- Cole tudo no SQL Editor do Supabase e execute UMA vez.\\n\\n'+f.map(n=>'-- >>> '+n+'\\n'+fs.readFileSync('supabase/migrations/'+n,'utf8')).join('\\n'))\""
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
