# Copie este arquivo para .env (local) e configure as mesmas variáveis no painel da hospedagem.
# NUNCA coloque aqui a service_role key nem senhas: tudo com prefixo VITE_ vai para o navegador.

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=
# Supabase > Project Settings > API > chave pública "anon" (ou "publishable")
VITE_SUPABASE_ANON_KEY=

# Endereço público final do site, sem barra no fim (usado em sitemap, robots e metadados).
# Ex.: https://www.globaltricot.com.br
VITE_SITE_URL=

# Só para GitHub Pages em subpasta (ex.: /global-tricot/). Em Vercel/Netlify deixe vazio.
VITE_BASE_PATH=
